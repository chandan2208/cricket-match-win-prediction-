# ============================================================
# Cricket Prediction System - Environment Configuration
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/cricket_prediction
MONGODB_URI_TEST=mongodb://localhost:27017/cricket_prediction_test

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# --- ML Microservice ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs

# --- External Data (optional: for live match data) ---
CRICAPI_KEY=030f173d-f3e7-4104-ad2b-8b028ca8ad53
CRICINFO_BASE_URL=https://api.cricapi.com/v1
